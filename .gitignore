# Local environments and generated Python files
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Credentials and machine-local agent plugins
.env
.env.*
!.env.example
*.pem
*.key
.agents/
.streamlit/secrets.toml

# Original datasets and preprocessing caches stay local
data/
artifacts/torch/
artifacts/pilot_model/
artifacts/model/semantic_features.npz
artifacts/experiments/**/semantic_features.npz
artifacts/experiments/**/*.pt
artifacts/experiments/**/*.npz
artifacts/experiments/**/*.log

# External dataset images remain local; commit manifests/metrics instead
artifacts/experiments/jpeg_pilot/*-comparison.jpg
artifacts/experiments/jpeg_pilot/overview.jpg

# Keep reports, comparison JPGs and source snapshots; skip duplicate PNGs/logs
artifacts/**/*.png
artifacts/**/run.log
artifacts/**/candidates.jpg
artifacts/**/heldout-candidates.jpg

# Immutable historical Chinese snapshots stay local and in prior Git history
artifacts/model/source_snapshot.zip
artifacts/preview_v2/source_snapshot.zip
artifacts/preview_v3/source_snapshot.zip
artifacts/model/app-preview.jpg
